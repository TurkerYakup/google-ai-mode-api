# --- HTTP ---
# Use a long random value, e.g. openssl rand -hex 32
# THE SERVICE REFUSES TO START IF THIS IS EMPTY -- see GAM_ALLOW_NO_AUTH below.
GAM_API_KEY=
# Deliberate opt-out from running without authentication. Only set true when the
# service is genuinely unreachable from outside (bound to 127.0.0.1 in compose).
# Inside a container the app always binds 0.0.0.0; whether that is exposed is decided
# by Docker's port publishing, which the app cannot see. So the call is yours.
GAM_ALLOW_NO_AUTH=false
# Opens /v1/debug/*. Turn on only while fixing selectors.
GAM_DEBUG_ENDPOINTS=false

# --- Search defaults ---
GAM_GOOGLE_DOMAIN=www.google.com
GAM_HL=tr
GAM_GL=TR
GAM_LOCALE=tr-TR
GAM_TIMEZONE=Europe/Istanbul

# --- Browser ---
GAM_HEADLESS=true
GAM_PROFILE_DIR=/data/profile
# Runs full Chromium in its new headless mode. Left empty, Playwright falls back to
# its "headless shell" binary, which Google flags as a bot more readily.
GAM_BROWSER_CHANNEL=chromium
# Concurrent tabs. Google's rate limiting is strict; do not go above 1-2.
GAM_POOL_SIZE=1
# Recycle a tab after this many requests to reclaim Chromium renderer memory.
GAM_PAGE_RECYCLE_AFTER=25
# LAST RESORT. Runs Chromium with --no-sandbox. This service renders untrusted remote
# JavaScript, so Chromium's sandbox is the last line of defence. It should not be
# needed: docker-compose.yml supplies Playwright's seccomp profile, which permits the
# clone/unshare calls the sandbox requires. Verify the profile is actually loaded
# before turning this on.
GAM_DISABLE_SANDBOX=false

# --- Proxy ---
# If your egress IP has been flagged by Google (a verification page on every search),
# the only practical fix is a different egress. Residential proxies work best.
# GAM_PROXY_SERVER=http://proxy.provider.com:8000
# Do not put credentials in the SERVER line, pass them separately:
# GAM_PROXY_USERNAME=user
# GAM_PROXY_PASSWORD=secret
# GAM_PROXY_BYPASS=localhost,127.0.0.1

# --- Timing (seconds) ---
GAM_NAV_TIMEOUT=45
GAM_ANSWER_TIMEOUT=90
GAM_STABLE_FOR=1.6

# --- Cache / pacing ---
GAM_CACHE_TTL=900
GAM_BATCH_DELAY=2.5
GAM_MAX_BATCH_SIZE=50

# --- Task retention (results are held in memory) ---
GAM_TASK_RETENTION=3600
GAM_TASK_MAX_RECORDS=200

# --- Cookie consent: reject (privacy-preserving) or accept ---
GAM_AUTO_CONSENT=true
GAM_CONSENT_CHOICE=reject

# --- Override when Google's DOM shifts (JSON array) ---
# GAM_ANSWER_SELECTORS=["div[data-subtree='aimc']","#im-box"]
