# --- HTTP ---
# Bos birakilirsa API kimlik dogrulamasi kapali olur. Disari acacaksaniz mutlaka doldurun.
GAM_API_KEY=
# /v1/debug/* uclarini acar. Sadece selector guncellerken true yapin.
GAM_DEBUG_ENDPOINTS=false

# --- Arama varsayilanlari ---
GAM_GOOGLE_DOMAIN=www.google.com
GAM_HL=tr
GAM_GL=TR
GAM_LOCALE=tr-TR
GAM_TIMEZONE=Europe/Istanbul

# --- Tarayici ---
GAM_HEADLESS=true
GAM_PROFILE_DIR=/data/profile
# Tam Chromium'u yeni headless modunda calistirir. Bos birakilirsa Playwright'in
# "headless shell" ikilisi kullanilir; o surum Google tarafindan daha kolay
# bot olarak isaretleniyor.
GAM_BROWSER_CHANNEL=chromium
# Es zamanli sekme sayisi. Google rate-limit'i sert; 1-2'nin ustune cikmayin.
GAM_POOL_SIZE=1

# --- Proxy ---
# Cikis IP'niz Google tarafindan isaretlendiyse (her aramada dogrulama ekrani)
# tek pratik cozum farkli bir cikis kullanmaktir. Residential proxy en iyi sonucu verir.
# GAM_PROXY_SERVER=http://proxy.saglayici.com:8000
# Kimlik bilgisini SERVER satirina koymayin, ayri verin:
# GAM_PROXY_USERNAME=kullanici
# GAM_PROXY_PASSWORD=sifre
# GAM_PROXY_BYPASS=localhost,127.0.0.1

# --- Zamanlama (saniye) ---
GAM_NAV_TIMEOUT=45
GAM_ANSWER_TIMEOUT=90
GAM_STABLE_FOR=1.6

# --- Onbellek / hiz ---
GAM_CACHE_TTL=900
GAM_BATCH_DELAY=2.5
GAM_MAX_BATCH_SIZE=50

# --- Cerez onayi: reject (gizlilik dostu) veya accept ---
GAM_AUTO_CONSENT=true
GAM_CONSENT_CHOICE=reject

# --- Google DOM'u degisirse buradan ezin (JSON dizi) ---
# GAM_ANSWER_SELECTORS=["div[data-subtree='aimc']","#im-box"]
